venv/
__pycache__/
*.pyc

# Pretrained YOLO weights (auto-downloaded by ultralytics, don't commit)
*.pt

# YOLO run artifacts outside the project's own results folder
runs/

# Downloaded dataset (rebuild with scripts/download_dataset.py)
data/dataset/*/

# Test videos (rebuild with scripts/download_videos.py; attribution.csv is tracked)
data/sample_videos/*.webm

# Built training set (rebuild with scripts/build_yolo_dataset.py)
data/yolo_dataset/

# Annotated pipeline videos (large; rebuild with scripts/video_pipeline.py)
data/results/pipeline/*.mp4
